# ==========================================================================
#  Пример файла настроек. Скопируйте его в файл `.env` и заполните значения.
#
#      cp .env.example .env
#
#  Файл `.env` НИКОГДА не коммитится в git (он в .gitignore).
# ==========================================================================

# --- Google Sheets ---------------------------------------------------------
# ID таблицы. Берётся из ссылки на таблицу:
# https://docs.google.com/spreadsheets/d/<ВОТ_ЭТОТ_ID>/edit
GOOGLE_SHEET_ID=

# Учётные данные сервисного аккаунта Google. Нужен ОДИН из двух вариантов:
#
#  1) Путь к JSON-файлу сервисного аккаунта (удобно локально):
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
#
#  2) Либо весь JSON одной строкой (удобно для GitHub Actions / секретов).
#     Если задано — имеет приоритет над файлом выше.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- OpenAI (ChatGPT API) --------------------------------------------------
OPENAI_API_KEY=
# Модель можно менять без правки кода.
OPENAI_MODEL=gpt-4.1-mini
# Максимальная длина сырого текста, отправляемого в модель (защита от расходов).
OPENAI_MAX_INPUT_CHARS=12000

# --- Telegram (Telethon) ---------------------------------------------------
# Получить тут: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Номер телефона в международном формате, например +994501234567
TELEGRAM_PHONE=
# Сколько последних постов читать из каждого канала.
TELEGRAM_POST_LIMIT=30
# Имя session-файла Telethon (создаётся при первой авторизации).
TELEGRAM_SESSION_NAME=telegram_session

# --- Ограничение расходов и режимы запуска ---------------------------------
# Максимум публикаций за один запуск (0 = без ограничения).
MAX_ITEMS_PER_RUN=100
# true — собрать и залогировать, но НИЧЕГО не писать в Google Sheets.
DRY_RUN=false
# true — не вызывать OpenAI API (проверка только парсинга).
SKIP_OPENAI=false

# --- Логирование -----------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
